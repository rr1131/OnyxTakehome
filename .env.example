# Clerk: copy both keys from the same application/instance. Never commit real keys.
# The time-boxed demo uses a Clerk development instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk routes. These values also have matching defaults in the application.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Neon: server-only PostgreSQL connection string (including sslmode=require).
DATABASE_URL=

# Onyx: server-only Bearer access token for https://predictions.dev-onyxodds.com.
# Observed lifetime is about 24 hours; replace manually when it expires.
ONYX_API_TOKEN=
