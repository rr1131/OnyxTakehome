# Clerk: copy keys from your Clerk application. Never commit real keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk routes. These values also have matching defaults in the application.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Neon: server-only PostgreSQL connection string (including sslmode=require).
DATABASE_URL=

# Onyx: server-only Bearer token. Reserved for a later block; unused in Block 1.
ONYX_API_TOKEN=
